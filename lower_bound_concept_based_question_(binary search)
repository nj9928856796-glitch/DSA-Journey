import java.util.*;

class Solution {

    public static int search(int[] arr, int target) {

        int n = arr.length;
        int st = 0;
        int end = n - 1;
        int ans = n;

        while (st <= end) {

            int mid = st + (end - st) / 2;

            if (arr[mid] >= target) {
                ans = mid;
                end = mid - 1;   // aur left mein check karo
            } else {
                st = mid + 1;    // right mein jao
            }
        }

        return ans;
    }
public static void main(String[]args){
    int [] arr = {1,1,3,3,4,5,6,6,7,8,8};
    int target= 6;
    int result = search(arr, target);
    System.out.println("index: "+ result);
    
}
}
