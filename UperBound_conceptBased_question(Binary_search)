class Main {

    public static int upperBound(int[] arr, int target) {

        int st = 0;
        int end = arr.length;

        while (st < end) {

            int mid = st + (end - st) / 2;

            if (arr[mid] <= target) {
                st = mid + 1;
            } else {
                end = mid;
            }
        }

        return st;
    }
}
